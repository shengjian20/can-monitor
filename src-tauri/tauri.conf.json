{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "can-monitor",
  "version": "0.1.0",
  "identifier": "com.canmonitor.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "title": "CAN Monitor",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": {
      "../third_party/controlcan/x86_64/libcontrolcan.so": "x86_64/libcontrolcan.so",
      "../third_party/controlcan/aarch64/libcontrolcan.so": "aarch64/libcontrolcan.so",
      "../third_party/controlcan/win64/ControlCAN.dll": "ControlCAN.dll"
    }
  }
}
